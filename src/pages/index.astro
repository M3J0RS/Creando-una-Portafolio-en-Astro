---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Portafolio Futurista</title>
    <link rel="stylesheet" href="public/styles.css">
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1 class="hero-title">Bienvenido a mi mundo digital</h1>
        <p class="hero-description">Soy Jonathan Romero, desarrollador con pasión por la tecnología y el futuro.</p>
      </section>

      <section class="projects">
        <h2 class="section-title">Mis Proyectos</h2>
        <div class="project-list">
          <div class="project-card">
            <h3>Proyecto 1</h3>
            <p></p>
            <a href="enlace-al-proyecto" class="project-link">Ver Proyecto</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

